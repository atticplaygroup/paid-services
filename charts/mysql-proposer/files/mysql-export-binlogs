#!/bin/bash
set -euo pipefail

required=(MYSQL_HOST MYSQL_PORT MYSQL_USER MYSQL_PASSWORD MYSQL_EXPORT_SCHEMAS OUTPUT_DIR)
for var in "${required[@]}"; do
  [[ -n "${!var:-}" ]] || { echo "missing env: $var" >&2; exit 1; }
done

mkdir -p "$OUTPUT_DIR"

GTID_EXECUTED=$(mysql -h "$MYSQL_HOST" -P "$MYSQL_PORT" -u "$MYSQL_USER" -p"$MYSQL_PASSWORD" -Nse "SELECT @@GLOBAL.gtid_executed")
BINLOG_FILE=$(mysql -h "$MYSQL_HOST" -P "$MYSQL_PORT" -u "$MYSQL_USER" -p"$MYSQL_PASSWORD" -Nse "SHOW MASTER STATUS" | awk '{print $1}')
BINLOG_POS=$(mysql -h "$MYSQL_HOST" -P "$MYSQL_PORT" -u "$MYSQL_USER" -p"$MYSQL_PASSWORD" -Nse "SHOW MASTER STATUS" | awk '{print $2}')

cat > "$OUTPUT_DIR/boundary.json" <<JSON
{"gtid_executed":"$GTID_EXECUTED","binlog_file":"$BINLOG_FILE","binlog_position":$BINLOG_POS,"schemas":"$MYSQL_EXPORT_SCHEMAS"}
JSON

BINLOG_BASENAME=$(mysql -h "$MYSQL_HOST" -P "$MYSQL_PORT" -u "$MYSQL_USER" -Nse "SELECT @@log_bin_basename" 2>/dev/null || echo "/var/lib/mysql/binlog")
BINLOG_DIR=$(dirname "$BINLOG_BASENAME")
BINLOG_FILES=$(find "$BINLOG_DIR" -maxdepth 1 -type f -name "$(basename "$BINLOG_BASENAME").*" ! -name "*.index" | sort)

for FILE in $BINLOG_FILES; do
  cp "$FILE" "$OUTPUT_DIR/"
done
ls "$OUTPUT_DIR"/ | grep -v boundary.json || true

echo "binlog export boundary written to $OUTPUT_DIR/boundary.json"
