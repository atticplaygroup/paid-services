#!/bin/bash
set -euo pipefail

required=(MYSQL_HOST MYSQL_PORT MYSQL_USER MYSQL_PASSWORD MYSQL_EXPORT_SCHEMAS \
  OCI_ADDRESS BASELINE_REPO DELTA_REPO MANIFEST_REPO APPLICATION OWNER OUTPUT_DIR)
for var in "${required[@]}"; do
  [[ -n "${!var:-}" ]] || { echo "missing env: $var" >&2; exit 1; }
done

EXPORT_DIR="$OUTPUT_DIR"
rm -rf "$EXPORT_DIR"
mkdir -p "$EXPORT_DIR"

OUTPUT_DIR="$EXPORT_DIR/baseline" mysql-export-baseline

cd "$EXPORT_DIR"
BASELINE_TAG="$(date +%Y%m%d%H%M%S)"
tar -czf baseline.tgz -C baseline .
oras push --plain-http "$OCI_ADDRESS/$BASELINE_REPO:$BASELINE_TAG" \
  --artifact-type application/vnd.paid.mysql.baseline.v1+tar \
  baseline.tgz:application/octet-stream

OUTPUT_DIR="$EXPORT_DIR/delta" mysql-export-binlogs

DELTA_TAG="$(date +%Y%m%d%H%M%S)"
if ls "$EXPORT_DIR"/delta/*.0000* >/dev/null 2>&1; then
  DELTA_LAYERS=()
  for BINLOG in "$EXPORT_DIR"/delta/*.0000*; do
    DELTA_LAYERS+=("$BINLOG:application/vnd.paid.mysql.binlogs.v1+tar")
  done
  oras push --plain-http "$OCI_ADDRESS/$DELTA_REPO:$DELTA_TAG" "${DELTA_LAYERS[@]}"
fi

MANIFEST_TAG="$BASELINE_TAG"
cat > "$EXPORT_DIR/application-manifest.yaml" <<MANIFEST
version: v1
owner: "$OWNER"
application: "$APPLICATION"
tag: "$MANIFEST_TAG"
databases:
  - type: mysql:v26.5.3
    name: "$APPLICATION"
    tag: "$MANIFEST_TAG"
    baseline:
      repo: "$BASELINE_REPO"
      gtid_end: "$(jq -r .gtid_executed "$EXPORT_DIR/baseline/boundary.json")"
    delta:
      repo: "$DELTA_REPO"
      gtid_start: "$(jq -r .gtid_executed "$EXPORT_DIR/baseline/boundary.json")"
      gtid_end: "$(jq -r .gtid_executed "$EXPORT_DIR/delta/boundary.json" 2>/dev/null || jq -r .gtid_executed "$EXPORT_DIR/baseline/boundary.json")"
    exported_schemas:
$(echo "$MYSQL_EXPORT_SCHEMAS" | tr ',' '\n' | sed 's/^/      - /')
storage: []
MANIFEST

# Push convenience "latest" tag for baseline
oras push --plain-http "$OCI_ADDRESS/$BASELINE_REPO:latest" \
  --artifact-type application/vnd.paid.mysql.baseline.v1+tar \
  baseline.tgz:application/octet-stream

MANIFEST_PATH=application-manifest.yaml \
OCI_ADDRESS="$OCI_ADDRESS" \
MANIFEST_REPO="$MANIFEST_REPO" \
MANIFEST_TAG="$MANIFEST_TAG" \
OWNER="$OWNER" \
publish-manifest

echo "publish complete: baseline=$BASELINE_TAG delta=$DELTA_TAG manifest=$MANIFEST_TAG"
