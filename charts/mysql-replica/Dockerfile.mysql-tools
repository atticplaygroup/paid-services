FROM mysql:8.0.42-oraclelinux9

USER root
RUN microdnf install -y mysql-shell && microdnf clean all

RUN microdnf install -y cpio && microdnf clean all && \
    curl -fsSL "https://dev.mysql.com/get/Downloads/MySQL-8.0/mysql-community-client-8.0.42-1.el9.x86_64.rpm" -o /tmp/client.rpm && \
    rpm2cpio /tmp/client.rpm > /tmp/client.cpio && mkdir -p /tmp/client-extract && \
    cd /tmp/client-extract && cpio -idm < /tmp/client.cpio && \
    mv /tmp/client-extract/usr/bin/mysqlbinlog /usr/local/bin/mysqlbinlog && \
    rm -rf /tmp/client* && microdnf remove -y cpio && microdnf clean all

ARG ORAS_VERSION=1.2.0
RUN curl -fsSL "https://github.com/oras-project/oras/releases/download/v${ORAS_VERSION}/oras_${ORAS_VERSION}_linux_amd64.tar.gz" \
    | tar -xz -C /usr/local/bin oras && chmod +x /usr/local/bin/oras

COPY files/mysql-export-baseline /usr/local/bin/mysql-export-baseline
COPY files/mysql-export-binlogs /usr/local/bin/mysql-export-binlogs
COPY files/publish-manifest /usr/local/bin/publish-manifest
COPY files/publish /usr/local/bin/publish
COPY files/mysql-import-baseline /usr/local/bin/mysql-import-baseline
COPY files/mysql-import-binlogs /usr/local/bin/mysql-import-binlogs
COPY files/import /usr/local/bin/import
RUN chmod +x /usr/local/bin/mysql-export-* /usr/local/bin/publish* /usr/local/bin/mysql-import-* /usr/local/bin/import

ENTRYPOINT []
CMD ["bash"]
