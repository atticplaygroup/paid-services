{
  "name": "outproxy",
  "type": "module",
  "scripts": {
    "build": "tsc && bun build src/server.ts --target=bun --outdir dist",
    "typecheck": "tsc",
    "dev": "bun run --hot src/server.ts",
    "start": "bun run src/server.ts",
    "quickstart:https": "bun run scripts/https-quickstart.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.13.0",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-web": "^2.1.2",
    "@noble/curves": "^2.3.0",
    "@scure/bip39": "^2.4.0",
    "dpop": "^2.1.1",
    "hono": "^4.12.32",
    "node-forge": "^1.4.0",
    "typescript": "^5.9.3",
    "multiformats": "^14.0.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node-forge": "^1.3.14"
  }
}
