{
  "name": "outproxy",
  "type": "module",
  "scripts": {
    "build": "tsc && bun build src/server.ts --target=bun --outdir dist",
    "typecheck": "tsc",
    "dev": "bun run --hot src/server.ts",
    "start": "bun run src/server.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.13.0",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-web": "^2.1.2",
    "dpop": "^2.1.1",
    "@noble/curves": "^2.3.0",
    "hono": "^4.12.32",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
